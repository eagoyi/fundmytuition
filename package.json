{
  "name": "fmtlite",
  "version": "1.0.0",
  "description": "An Education Acceleration/Funding Platform",
  "private": true,
  "main": "app.js",
  "scripts": {
    "compile": "tsc",
    "build": "npm run build --prefix client",
    "run:server": "npm run compile && node ./dist/app.js",
    "start": "npm run build && npm run run:server",
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/app.ts"
  },
  "dependencies": {
    "@babel/node": "^7.8.4",
    "@babel/runtime": "^7.8.4",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.14.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-import": "^2.20.1",
    "express": "^4.16.4",
    "express-handlebars": "^3.1.0",
    "helmet": "^3.21.2",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "morgan": "~1.9.1",
    "pg": "^7.18.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0",
    "react-responsive-carousel": "^3.2.23",
    "react-router-dom": "^7.13.2",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.8.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "babel-preset-airbnb": "^4.4.0",
    "dotenv": "^8.2.0",
    "nodemon": "^2.0.2",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webpack": "^5.30.0",
    "webpack-cli": "^4.6.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.1.2"
  }
}
